@echo off
rem ============================================================
rem Пересборка офлайн-кэша (sw.js) после замены файлов проекта.
rem Запускайте двойным кликом ПОСЛЕ каждого копирования файлов
rem от ZCode в проект и ПЕРЕД локальным тестированием.
rem
rem Что делает: запускает .github/scripts/sw-build.sh через Git Bash.
rem При публикации на GitHub это делает Action автоматически,
rem локально — нужно один раз запустить этот файл.
rem ============================================================
chcp 65001 >nul
cd /d "%~dp0"
echo Пересборка офлайн-кэша...
bash .github/scripts/sw-build.sh
if errorlevel 1 (
  echo.
  echo ОШИБКА: не удалось запустить скрипт. Проверьте, что Git Bash установлен.
) else (
  echo.
  echo Готово! Теперь откройте приложение в браузере и обновите страницу.
  echo Если появится баннер "Обновить" - нажмите его.
)
echo.
pause
